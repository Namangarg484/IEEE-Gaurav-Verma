\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Proposed Multimodal 1D+2D+3D Fusion Network architecture. The raw PPG signal is simultaneously transformed into three heterogeneous representations feeding equal-dimension (256-d) branch encoders. A cross-attention module with a learnable query vector fuses the branches into a 768-d representation passed to the FC regression head.}}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:architecture}{{1}{8}{Proposed Multimodal 1D+2D+3D Fusion Network architecture. The raw PPG signal is simultaneously transformed into three heterogeneous representations feeding equal-dimension (256-d) branch encoders. A cross-attention module with a learnable query vector fuses the branches into a 768-d representation passed to the FC regression head}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Example multimodal transformation of a single PPG window (sample index 350, glucose $\approx $115~mg/dL). \textbf  {(A)} Z-score normalised 1D temporal signal; \textbf  {(B)} 2D CWT time-frequency scalogram ($64\times 64$ pixels, Mexican hat wavelet); \textbf  {(C)} 3D Takens delay-embedding phase-space attractor ($\tau =5$, $N_p=256$ points), coloured by the third coordinate.}}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{8}{Example multimodal transformation of a single PPG window (sample index 350, glucose $\approx $115~mg/dL). \textbf {(A)} Z-score normalised 1D temporal signal; \textbf {(B)} 2D CWT time-frequency scalogram ($64\times 64$ pixels, Mexican hat wavelet); \textbf {(C)} 3D Takens delay-embedding phase-space attractor ($\tau =5$, $N_p=256$ points), coloured by the third coordinate}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Training convergence over 42 epochs (early stopped). ReduceLROnPlateau halved the LR at epochs 19 and 33 (vertical arrows not shown). Best validation MSE of 82.47~mg/dL² achieved at epoch~27.}}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:loss}{{3}{9}{Training convergence over 42 epochs (early stopped). ReduceLROnPlateau halved the LR at epochs 19 and 33 (vertical arrows not shown). Best validation MSE of 82.47~mg/dL² achieved at epoch~27}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Clarke Error Grid for 280 validation predictions. 277 points (98.9\%) lie in Zone~A; 3 points (1.1\%) lie in Zone~B; zero points in Zones C--E, indicating strong estimation agreement under the evaluated conditions.}}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:clarke}{{4}{9}{Clarke Error Grid for 280 validation predictions. 277 points (98.9\%) lie in Zone~A; 3 points (1.1\%) lie in Zone~B; zero points in Zones C--E, indicating strong estimation agreement under the evaluated conditions}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Predicted vs.\ reference glucose scatter (left) and residual histogram (right) for the 280-window validation set. Points are colour-coded by patient (patients 19--22). MAE~=~6.89~mg/dL, RMSE~=~9.08~mg/dL. The residual distribution is approximately zero-centred, indicating minimal systematic bias.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:overlay}{{5}{9}{Predicted vs.\ reference glucose scatter (left) and residual histogram (right) for the 280-window validation set. Points are colour-coded by patient (patients 19--22). MAE~=~6.89~mg/dL, RMSE~=~9.08~mg/dL. The residual distribution is approximately zero-centred, indicating minimal systematic bias}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Cross-attention branch weight distribution across 280 validation windows. Left: mean $\pm $ std bar chart; Right: violin plots. The 1D temporal branch receives the highest mean weight ($0.515\pm 0.124$), followed by the 3D phase-space branch ($0.303\pm 0.075$) and the 2D CWT branch ($0.182\pm 0.084$).}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:attention}{{6}{9}{Cross-attention branch weight distribution across 280 validation windows. Left: mean $\pm $ std bar chart; Right: violin plots. The 1D temporal branch receives the highest mean weight ($0.515\pm 0.124$), followed by the 3D phase-space branch ($0.303\pm 0.075$) and the 2D CWT branch ($0.182\pm 0.084$)}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Signal Quality Index analysis. \textbf  {Left}: distribution of per-window raw PPG standard deviation across all windows (threshold $\tau =0.25$, dashed red). \textbf  {Centre}: per-patient SQI pass rates (patients 19--22). \textbf  {Right}: SQI vs.\ glucose scatter; flatlines are not glucose-biased, confirming artefact-random occurrence.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:sqi}{{7}{9}{Signal Quality Index analysis. \textbf {Left}: distribution of per-window raw PPG standard deviation across all windows (threshold $\tau =0.25$, dashed red). \textbf {Centre}: per-patient SQI pass rates (patients 19--22). \textbf {Right}: SQI vs.\ glucose scatter; flatlines are not glucose-biased, confirming artefact-random occurrence}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces t-SNE of the 768-d fused latent space ($n=280$ val windows). \textbf  {Left}: coloured by patient ID; silhouette score $-0.067$ confirms no patient-identity clustering. \textbf  {Right}: coloured by glucose label, showing a diffuse glucose gradient rather than sharp identity-driven boundaries.}}{10}{figure.caption.12}\protected@file@percent }
\newlabel{fig:tsne}{{8}{10}{t-SNE of the 768-d fused latent space ($n=280$ val windows). \textbf {Left}: coloured by patient ID; silhouette score $-0.067$ confirms no patient-identity clustering. \textbf {Right}: coloured by glucose label, showing a diffuse glucose gradient rather than sharp identity-driven boundaries}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Cardiovascular attractor analysis for SQI-clean validation windows. \textbf  {Top row}: correlation dimension $D_2$ and largest Lyapunov exponent (LLE) versus glucose (Pearson $r=-0.072$ / $r=+0.085$). \textbf  {Bottom row}: example 3D Takens attractors for low, mid, and high glucose windows.}}{10}{figure.caption.13}\protected@file@percent }
\newlabel{fig:attractor}{{9}{10}{Cardiovascular attractor analysis for SQI-clean validation windows. \textbf {Top row}: correlation dimension $D_2$ and largest Lyapunov exponent (LLE) versus glucose (Pearson $r=-0.072$ / $r=+0.085$). \textbf {Bottom row}: example 3D Takens attractors for low, mid, and high glucose windows}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Cross-dataset generalisation experiment (PhysioNet BIG~IDEAs, Subject~001, Empatica~E4 BVP 64~Hz). \textbf  {(A)} MAE comparison: in-distribution Archive validation (6.89~mg/dL, blue); zero-shot transfer with all weights frozen (15.20~mg/dL, orange); fine-tuned cross-attention and head only (13.99~mg/dL, green). The $\Delta $MAE arrow shows $-1.21$~mg/dL improvement from fine-tuning. \textbf  {(B)} Per-epoch validation MAE during 15-epoch fine-tuning (Adam, $\eta $=$10^{-3}$, batch~32). Best val MAE 13.25~mg/dL at epoch~11; final reported MAE 13.99~mg/dL at epoch~15. Orange dashed: zero-shot baseline (15.20~mg/dL).}}{10}{figure.caption.14}\protected@file@percent }
\newlabel{fig:crossdataset}{{10}{10}{Cross-dataset generalisation experiment (PhysioNet BIG~IDEAs, Subject~001, Empatica~E4 BVP 64~Hz). \textbf {(A)} MAE comparison: in-distribution Archive validation (6.89~mg/dL, blue); zero-shot transfer with all weights frozen (15.20~mg/dL, orange); fine-tuned cross-attention and head only (13.99~mg/dL, green). The $\Delta $MAE arrow shows $-1.21$~mg/dL improvement from fine-tuning. \textbf {(B)} Per-epoch validation MAE during 15-epoch fine-tuning (Adam, $\eta $=$10^{-3}$, batch~32). Best val MAE 13.25~mg/dL at epoch~11; final reported MAE 13.99~mg/dL at epoch~15. Orange dashed: zero-shot baseline (15.20~mg/dL)}{figure.caption.14}{}}
